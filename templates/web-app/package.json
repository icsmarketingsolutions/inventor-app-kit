{
  "name": "inventor-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "privacy": "node ./scripts/check-privacy.mjs",
    "preview": "vite preview",
    "desktop:install": "pwsh -NoProfile -File ./scripts/desktop/install-app.ps1",
    "desktop:start": "pwsh -NoProfile -File ./scripts/desktop/start-app.ps1",
    "desktop:status": "pwsh -NoProfile -File ./scripts/desktop/status-app.ps1",
    "desktop:stop": "pwsh -NoProfile -File ./scripts/desktop/stop-app.ps1",
    "desktop:uninstall": "pwsh -NoProfile -File ./scripts/desktop/uninstall-app.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.80.0",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
